# ==============================================================================
# DISASTERSENSE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Fill in real values locally in .env.local — NEVER commit live credentials to Git.

# Provider A: Google Gemini API (Eligible free-tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Base URL (e.g. http://localhost:3000 or production Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Persistence (Optional PostgreSQL / Supabase / Neon connection URL)
DATABASE_URL=postgresql://user:password@localhost:5432/disastersense

# Authentication Session Secret
AUTH_SECRET=your_random_32_character_secret_string

# Open-Meteo & Open-Data settings (Default: Free Tier Non-Commercial endpoints)
NEXT_PUBLIC_OPEN_METEO_BASE=https://api.open-meteo.com/v1
NEXT_PUBLIC_OPEN_METEO_FLOOD_BASE=https://flood-api.open-meteo.com/v1
NEXT_PUBLIC_USGS_BASE=https://earthquake.usgs.gov/fdsnws/event/1
NEXT_PUBLIC_GDACS_BASE=https://www.gdacs.org/gdacsapi/api
